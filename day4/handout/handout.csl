<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info><title>Handout author-year with numbered bibliography</title><id>handout-style</id><updated>2026-09-15T00:00:00+00:00</updated></info>
  <macro name="first-author">
    <names variable="author">
      <name initialize-with=". " and="text" delimiter=", " et-al-min="3" et-al-use-first="1"/>
      <et-al font-style="normal"/>
    </names>
  </macro>
  <macro name="all-authors">
    <names variable="author">
      <name initialize-with=". " delimiter=", " delimiter-precedes-last="always" et-al-min="3" et-al-use-first="1"/>
      <et-al font-style="italic"/>
    </names>
  </macro>
  <citation et-al-min="3" et-al-use-first="1">
    <layout prefix="[" suffix="]" delimiter="; ">
      <group delimiter=", ">
        <text macro="first-author"/>
        <date variable="issued"><date-part name="year"/></date>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=" ">
        <group delimiter=", ">
          <text macro="all-authors"/>
          <text variable="title" quotes="true" suffix="."/>
        </group>
        <text variable="container-title" suffix=","/>
        <date variable="issued" suffix="."><date-part name="year"/></date>
      </group>
    </layout>
  </bibliography>
</style>
